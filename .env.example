# Local ARGUS configuration
ARGUS_APP_NAME=ARGUS
ARGUS_ENVIRONMENT=development
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_JSON=false
ARGUS_MAX_INVESTIGATION_ITERATIONS=5
ARGUS_MIN_CONFIDENCE=0.75
ARGUS_RESEARCH_TIMEOUT_SECONDS=30
ARGUS_CASCADE_MAX_FALLBACKS=2
ARGUS_MCP_TIMEOUT_SECONDS=10
ARGUS_MCP_MAX_RETRIES=2
ARGUS_MCP_RETRY_BACKOFF_SECONDS=0.25
ARGUS_REACT_MAX_ITERATIONS=8
ARGUS_REACT_MAX_TOOL_CALLS=8

# OpenAI configuration
# Paste your key after the equals sign. Do not add quotes or spaces.
OPENAI_API_KEY= sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional HTTP MCP service endpoints.
# ARGUS_NEWS_MCP_URL=http://localhost:8101
# ARGUS_GOVERNMENT_MCP_URL=http://localhost:8102
# ARGUS_MARKET_MCP_URL=http://localhost:8103
# ARGUS_COMPANY_MCP_URL=http://localhost:8104
